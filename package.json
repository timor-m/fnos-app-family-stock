{
  "name": "fnos-app-family-stock",
  "version": "1.0.7",
  "description": "Family inventory and expiry management for fnOS",
  "type": "module",
  "author": {
    "name": "timor-m"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timor-m/fnos-app-family-stock.git"
  },
  "templateRepository": {
    "type": "git",
    "url": "git+https://github.com/timor-m/fnos-app-template.git"
  },
  "bugs": {
    "url": "https://github.com/timor-m/fnos-app-family-stock/issues"
  },
  "homepage": "https://github.com/timor-m/fnos-app-family-stock#readme",
  "workspaces": [
    "packages/ui",
    "packages/server",
    "packages/assets"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite --config packages/ui/vite.config.ts",
    "dev:server": "node scripts/dev.mjs",
    "test": "node --experimental-strip-types --test packages/server/services/*.test.ts",
    "build:web": "vite build --config packages/ui/vite.config.ts",
    "build": "npm run build:web && nitro build",
    "generate:icons": "node scripts/generate-icons.mjs",
    "start": "node scripts/start.mjs",
    "download:fnpack": "node scripts/download-fnpack.mjs",
    "prepare:package": "node scripts/prepare-package.mjs",
    "validate:package": "node scripts/validate-package.mjs",
    "pack:app": "npm run build && npm run prepare:package && bash scripts/pack-app.sh && npm run validate:package",
    "pack:fpk": "npm run pack:app && bash scripts/pack-fpk.sh",
    "test:ui": "vitest run",
    "typecheck": "vue-tsc -p tsconfig.ui.json",
    "test:mcp": "npm run build && node scripts/test-mcp.mjs && node scripts/test-mcp-upgrade.mjs && node scripts/test-mcp-listener.mjs && node scripts/test-mcp-listener.mjs --local && node scripts/test-mcp-listener.mjs --local-no-vite"
  },
  "dependencies": {
    "@lucide/vue": "^1.25.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "concurrently": "^10.0.3",
    "jimp": "^1.6.1",
    "nitro": "3.0.260610-beta",
    "vite": "^8.0.16",
    "vue": "^3.5.38",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@vue/test-utils": "^2.6.0",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.3",
    "vitest": "^5.1.2",
    "vue-tsc": "^3.3.14"
  }
}
